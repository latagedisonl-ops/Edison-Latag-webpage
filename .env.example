# --- Alpaca (stocks broker) ---
# https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=your_key_here
ALPACA_API_SECRET=your_secret_here
# paper: https://paper-api.alpaca.markets   live: https://api.alpaca.markets
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Telegram ---
# Create a bot via @BotFather to get the token
TELEGRAM_BOT_TOKEN=your_token_here
# Your numeric chat id (message @userinfobot to get it)
TELEGRAM_CHAT_ID=your_chat_id_here

# --- Default trading parameters (editable from the web UI) ---
WATCHLIST=AAPL,MSFT,NVDA,SPY,QQQ,TSLA,AMD,META
TIMEFRAME=15Min
RISK_PER_TRADE=0.01
MAX_OPEN_POSITIONS=5
MAX_DAILY_LOSS=0.03
EXECUTION_MODE=manual

# --- Web dashboard ---
WEB_HOST=127.0.0.1
WEB_PORT=8787
# Required for any non-localhost access. If unset, a random token is generated
# at startup and printed to the log; localhost is also allowed without it.
WEB_AUTH_TOKEN=
