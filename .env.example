# --- Alpaca (stocks broker) ---
# Get keys from https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=your_key_here
ALPACA_API_SECRET=your_secret_here
# Use https://paper-api.alpaca.markets for paper, https://api.alpaca.markets for live
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Telegram ---
# Create a bot via @BotFather, get the token
TELEGRAM_BOT_TOKEN=your_token_here
# Your numeric chat id (message @userinfobot to get it)
TELEGRAM_CHAT_ID=your_chat_id_here

# --- Bot settings ---
# comma-separated symbols to scan
WATCHLIST=AAPL,MSFT,NVDA,SPY,QQQ,TSLA,AMD,META
# bar timeframe: 1Min, 5Min, 15Min, 1Hour, 1Day
TIMEFRAME=15Min
# Risk per trade as fraction of equity (0.01 = 1%)
RISK_PER_TRADE=0.01
# Max concurrent open positions
MAX_OPEN_POSITIONS=5
# Max daily loss as fraction of equity before bot halts
MAX_DAILY_LOSS=0.03
# 'manual' (Telegram approval) or 'auto'
EXECUTION_MODE=manual
